{
  "manifest_version": 2,
  "name": "folia-bridge",
  "version": "2.1",
  "description": "Bridge between local web UI and native GeckoView shell.",
  "browser_specific_settings": {
    "gecko": {
      "id": "folia-bridge@folia.app"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
